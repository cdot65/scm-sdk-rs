  "readerSource": "\"use strict\";\n// Read-only watcher, sent on stdin into the existing CI job container.\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\nconst crypto = require(\"node:crypto\");\nconst cp = require(\"node:child_process\");\nconst [root, expectedCommit] = process.argv.slice(2);\nif (!path.isAbsolute(root) || !/^[a-f0-9]{40}$/.test(expectedCommit)) process.exit(2);\nconst started = Date.now();\nconst filename = path.join(root, \"docs/checks/phase-08.json\");\nconst digest = data => crypto.createHash(\"sha256\").update(data).digest(\"hex\");\nconst git = arguments_ => cp.execFileSync(\"git\", [\"-c\", `safe.directory=${root}`, \"-C\", root, ...arguments_],\n                                   { encoding: \"utf8\", timeout: 5000 }).trim();\nconst commit = () => git([\"rev-parse\", \"HEAD\"]);\nif (commit() !== expectedCommit) process.exit(3);\nconst initial = fs.existsSync(filename) ? digest(fs.readFileSync(filename)) : null;\nlet emittedParent = null;\nconst initialChildren = new Map();\nfor (const name of fs.readdirSync(path.join(root, \"docs/checks\"))) {\n  if (/^phase-08[^/]*\\.json$/.test(name)) {\n    const full = path.join(root, \"docs/checks\", name);\n    const info = fs.lstatSync(full);\n    if (info.isFile() && info.size <= 64 * 1024 * 1024)\n      initialChildren.set(`docs/checks/${name}`, digest(fs.readFileSync(full)));\n  }\n}\nfunction boundedRead(relative) {\n  if (!/^docs\\/checks\\/phase-08[^/]*\\.json$/.test(relative)) throw new Error(\"Unexpected report path\");\n  const full = path.join(root, relative);\n  const info = fs.lstatSync(full);\n  if (!info.isFile() || info.size > 64 * 1024 * 1024) throw new Error(\"Report not bounded\");\n  const content = fs.readFileSync(full);\n  return { path: relative, sha256: digest(content), rawBase64: content.toString(\"base64\"), report: JSON.parse(content) };\n}\nlet busy = false;\nconst timer = setInterval(async () => {\n  if (busy) return;\n  busy = true;\n  if (Date.now() - started > 3 * 60 * 60 * 1000) process.exit(4);\n  try {\n    const parent = boundedRead(\"docs/checks/phase-08.json\");\n    if (parent.sha256 === initial || parent.report.phase !== 8 ||\n        !Array.isArray(parent.report.checks) ||\n        !(Date.parse(parent.report.checked_at) >= started)) return;\n    // Preserve the parent immediately; job cleanup may remove the container\n    // before the optional child-report and source-inventory bundle finishes.\n    if (emittedParent !== parent.sha256) {\n      await new Promise((resolve, reject) => process.stdout.write(JSON.stringify({\n        kind: \"phase_report\", schemaVersion: 1,\n        capturedAt: new Date().toISOString(), sourceCommit: commit(),\n        watcherStartedAt: new Date(started).toISOString(), parent,\n      }) + \"\\n\", error => error ? reject(error) : resolve()));\n      emittedParent = parent.sha256;\n    }\n    const reports = [];\n    for (const check of parent.report.checks) {\n      const index = check.command.indexOf(\"--output\");\n      if (index === -1) continue;\n      const relative = check.command[index + 1];\n      if (/^docs\\/checks\\/phase-08[^/]*\\.json$/.test(relative)) {\n        const item = boundedRead(relative);\n        item.changedSinceWatcherStarted = initialChildren.get(relative) !== item.sha256;\n        reports.push(item);\n      }\n    }\n    const after = commit();\n    const sourceFiles = [];\n    const names = [...new Set(git([\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"-z\"])\n      .split(\"\\0\").filter(Boolean))].sort();\n    let sourceBytes = 0;\n    for (const name of names) {\n      if (name === \"docs/phase-status.json\" || name.startsWith(\"docs/checks/\") ||\n          name.startsWith(\"docs/reviews/\")) continue;\n      const full = path.resolve(root, name);\n      if (!full.startsWith(root + path.sep)) throw new Error(\"Invalid source path\");\n      const info = fs.lstatSync(full);\n      sourceBytes += info.size;\n      if (sourceFiles.length >= 32768 || info.size > 64 * 1024 * 1024 ||\n          sourceBytes > 256 * 1024 * 1024) throw new Error(\"Source bound exceeded\");\n      sourceFiles.push(info.isFile() ? {path: name, sha256: digest(fs.readFileSync(full)), bytes: info.size}\n                                   : {path: name, regularFile: false});\n    }\n    const result = {\n      kind: \"phase_bundle\",\n      schemaVersion: 1,\n      capturedAt: new Date().toISOString(),\n      watcherStartedAt: new Date(started).toISOString(),\n      method: \"Read-only watcher in the existing Forgejo job container through configured kubectl and Docker access.\",\n      sourceCommit: expectedCommit, commitUnchanged: after === expectedCommit,\n      parent, reports, sourceFiles,\n      limits: [\"Reads generated credential-free reports without changing the job filesystem or environment.\",\n               \"The phase report and job completion are independently confirmed against Forgejo run metadata.\"]\n    };\n    clearInterval(timer);\n    await new Promise((resolve, reject) => process.stdout.write(JSON.stringify(result) + \"\\n\", error => error ? reject(error) : resolve()));\n  } catch (_) {\n    // A report can be observed during its ordinary write; wait for valid JSON.\n  } finally {\n    busy = false;\n  }\n}, 250);\n",
  "readerSha256": "925e93c8622074a10cd175ac1e763d618c35bf17c9d88862acdc0b625435b366",
  "limitations": [
    "Configured read-only kubectl/Docker access observed the existing CI workspace without changing job files, environment or results.",
    "Forgejo statuses establish source-bound job outcomes; actual retained reports establish the detailed host, compiler and command evidence they name.",
    "Optional native jobs were not executed; GNU job success does not establish other operating systems or live service workflows."
  ]
}
