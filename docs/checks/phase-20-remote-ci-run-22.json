      "producerSource": "#!/usr/bin/env python3\n\"\"\"Record terminal CI only after the exact configured context set has passed.\"\"\"\nimport datetime,json,re,sys\nfrom pathlib import Path\nsys.path.insert(0,'tools')\nfrom review_phase import fingerprint\nsource=sys.argv[1]\nreviewed=sys.argv[2]\nrun_number=int(sys.argv[3])\ncaptured=json.loads(Path('.local/delivery-ci-'+source+'.json').read_text())\nworkflow=Path('.forgejo/workflows/ci.yml').read_text()\nname=re.search(r'^name: (.+)$',workflow,re.M).group(1)\ndef matrix(key):return json.loads(re.search(r'^\\s+'+key+r': (\\[.*\\])$',workflow,re.M).group(1))\nexpected={name+' / contracts-and-package (push)'}|{name+' / rust ('+f+', '+t+') (push)' for f in matrix('features') for t in matrix('toolchain')}\nlatest=captured['latest']\nassert set(latest)==expected,'CI context identities differ from configured matrix'\nassert all(r['status']=='success' for r in latest.values()),'CI has non-success contexts'\nruns=captured['summary']['runs'];run=next(r for r in runs if r['index_in_repo']==run_number)\nassert run['status']=='success' and run['commit_sha']==source,'Workflow is not terminal success'\nassert fingerprint()==reviewed,'Accepted source changed'\nreceipt={'schemaVersion':1,'observedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'sourceCommit':source,'reviewedSourceSha256':reviewed,'run':run,'expectedJobCount':len(expected),'contextsMatchConfiguredMatrix':True,'counts':{'success':len(latest)},'jobs':[{k:row.get(k) for k in ('context','status','target_url','created_at','updated_at')} for _,row in sorted(latest.items())],'scope':'Authenticated Forgejo run/commit-status API metadata confirms every configured job. No unavailable job logs or additional platform/live results are invented.'}\npath=Path(f'docs/checks/phase-20-remote-ci-run-{run_number}.json');path.write_text(json.dumps(receipt,indent=2)+'\\n')\np=Path('docs/phase-status.json');status=json.loads(p.read_text());phase=next(x for x in status['phases'] if x['id']==20)\nphase['remote_ci']={'status':'success','run':run_number,'expected_jobs':len(expected),'passed_jobs':len(latest),'source_commit':source,'evidence':[str(path)]}\nphase['delivery']={'status':'complete','source_commit':source,'registry_receipt':'docs/checks/release-registry-0.2.2.json','tag_receipt':'docs/checks/release-tag-v0.2.2.json','ci_receipt':str(path)}\nphase.setdefault('milestones', {})['remote_delivery']={'status':'passed','evidence':[str(path)],'source_commit':source,'reviewed_source_sha256':reviewed}\np.write_text(json.dumps(status,indent=2)+'\\n')\nprint(json.dumps({'terminal_success':True,'exact_configured_jobs':len(expected),'source':source,'receipt':str(path)}))\n"
