      "producerSource": "#!/usr/bin/env python3\n\"\"\"Read owner-repository CI status without forwarding credentials on redirects.\"\"\"\nimport json, os, re, sys, urllib.request\nfrom pathlib import Path\ncommit=sys.argv[1]\nif not re.fullmatch(r'[0-9a-f]{40}',commit):raise SystemExit('Expected full source commit')\ntoken=os.environ.get('FORGEJO_TOKEN') or os.environ.get('CDOT_ENV_FORGEJO_TOKEN')\nif not token:raise SystemExit('Read token unavailable')\nclass RejectRedirects(urllib.request.HTTPRedirectHandler):\n    def redirect_request(self,*args,**kwargs):return None\nopener=urllib.request.build_opener(RejectRedirects())\nbase='https://git.cdot.io/api/v1/repos/cdot/scm-sdk-rs/'\ndef get(path):\n    request=urllib.request.Request(base+path,headers={'Authorization':'token '+token,'Accept':'application/json'})\n    with opener.open(request,timeout=20) as reply:return json.load(reply)\nrows=[]\nfor page in range(1,21):\n    part=get('statuses/'+commit+'?limit=100&page='+str(page))\n    if not isinstance(part,list):raise SystemExit('Unexpected status response')\n    rows.extend(part)\n    if not part or len({r['context'] for r in rows})>=49:break\nlatest={}\nfor row in rows:latest.setdefault(row['context'],row)\ncounts={}\nfor row in latest.values():counts[row['status']]=counts.get(row['status'],0)+1\nruns=get('actions/runs')\nif isinstance(runs,dict):runs=runs.get('workflow_runs',runs.get('runs',[]))\nmatching=[{k:r.get(k) for k in ('id','index_in_repo','commit_sha','prettyref','status','html_url')} for r in runs if r.get('commit_sha')==commit]\nresult={'commit':commit,'contexts':len(latest),'counts':counts,'failures':[{'context':r['context'],'status':r['status'],'target_url':r.get('target_url')} for r in latest.values() if r['status'] in ('failure','error')],'runs':matching}\np=Path('.local/delivery-ci-'+commit+'.json');p.write_text(json.dumps({'summary':result,'latest':latest},indent=2)+'\\n');p.chmod(0o600)\nprint(json.dumps(result))\n"
    },
