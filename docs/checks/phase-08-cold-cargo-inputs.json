  "reproducerSource": "#!/usr/bin/env python3\n\"\"\"Exercise filtered and unfiltered locked Cargo input preparation in a fresh cache.\"\"\"\nimport datetime\nimport hashlib\nimport importlib.util\nimport json\nimport os\nimport pathlib\nimport subprocess\nimport sys\nimport tempfile\nimport time\n\nROOT = pathlib.Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / \"tools\"))\nfrom review_phase import fingerprint\n\nspec = importlib.util.spec_from_file_location(\"native_runner\", ROOT / \"scripts/check-native-exports.py\")\nrunner = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(runner)\ncargo = runner.cargo_path()\ncache = pathlib.Path(tempfile.mkdtemp(prefix=\"ci-cold-cargo-\", dir=ROOT / \".local\"))\nassert not list(cache.iterdir())\nsource = fingerprint(ROOT)\nlock_sha = hashlib.sha256((ROOT / \"Cargo.lock\").read_bytes()).hexdigest()\nenv = os.environ.copy()\nfor key in list(env):\n    if key.startswith((\"PANW_\", \"AIRS_\", \"SCM_\", \"CARGO_REGISTRY_\", \"CARGO_REGISTRIES_\", \"CARGO_SOURCE_\")) or any(\n        word in key.upper() for word in (\"TOKEN\", \"SECRET\", \"PASSWORD\", \"API_KEY\", \"ACCESS_KEY\")\n    ):\n        env.pop(key)\nenv.update({\"CARGO_HOME\": str(cache), \"RUSTUP_TOOLCHAIN\": \"1.99.0\", \"CARGO_TERM_COLOR\": \"never\",\n            \"PATH\": str(cargo.parent) + os.pathsep + env.get(\"PATH\", \"\")})\nfor key in (\"CARGO_NET_OFFLINE\", \"RUSTC_WRAPPER\", \"RUSTC_WORKSPACE_WRAPPER\"):\n    env.pop(key, None)\nrecords = []\nbefore_cached = []\nafter_cached = []\nresolved = []\nreproduced = False\n\n\ndef cached():\n    return sorted(path.name for path in (cache / \"registry/cache\").glob(\"*/*.crate\"))\n\n\ndef run(arguments):\n    command = [str(cargo), \"+1.99.0\", *arguments]\n    started = time.monotonic()\n    result = subprocess.run(command, cwd=ROOT, env=env, capture_output=True, text=True, timeout=240)\n    records.append({\"command\": command, \"exitCode\": result.returncode,\n                    \"stdout\": \"[metadata payload omitted]\" if \"metadata\" in arguments else result.stdout,\n                    \"stderr\": result.stderr, \"seconds\": round(time.monotonic() - started, 3)})\n    print(json.dumps({\"step\": arguments, \"exitCode\": result.returncode}), flush=True)\n    return result\n\n\nfor target in (\"x86_64-unknown-linux-gnu\", \"aarch64-unknown-linux-gnu\",\n               \"aarch64-apple-darwin\", \"x86_64-pc-windows-msvc\"):\n    result = run([\"fetch\", \"--locked\", \"--target\", target])\n    if result.returncode:\n        break\nelse:\n    before_cached = cached()\n    before = run([\"metadata\", \"--all-features\", \"--locked\", \"--offline\", \"--format-version\", \"1\"])\n    print(json.dumps({\"offlineMetadataBeforeExit\": before.returncode, \"stderr\": before.stderr[-2000:]}), flush=True)\n    if before.returncode:\n        fetched = run([\"fetch\", \"--locked\"])\n        if fetched.returncode == 0:\n            after = run([\"metadata\", \"--all-features\", \"--locked\", \"--offline\", \"--format-version\", \"1\"])\n            after_cached = cached()\n            if after.returncode == 0:\n                resolved = [{key: package.get(key) for key in (\"name\", \"version\", \"license\", \"source\")}\n                            for package in json.loads(after.stdout)[\"packages\"]]\n                reproduced = True\n            print(json.dumps({\"offlineMetadataAfterExit\": after.returncode, \"packages\": len(resolved)}), flush=True)\nreport = {\n    \"schemaVersion\": 1,\n    \"checkedAt\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    \"sourceCommit\": subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=ROOT).decode().strip(),\n    \"sourceSha256\": source,\n    \"sourceUnchanged\": fingerprint(ROOT) == source,\n    \"cargoLockSha256\": lock_sha,\n    \"lockUnchanged\": hashlib.sha256((ROOT / \"Cargo.lock\").read_bytes()).hexdigest() == lock_sha,\n    \"cargoHome\": str(cache),\n    \"startedWithEmptyCargoHome\": True,\n    \"localCompilerWrappersDisabledOnlyForReproducer\": True,\n    \"reproducedFilteredCacheFailureAndUnfilteredRepair\": reproduced,\n    \"checks\": records,\n    \"filteredCacheArchives\": before_cached,\n    \"additionalArchivesFetchedWithoutTargetFilter\": sorted(set(after_cached) - set(before_cached)),\n    \"resolvedPackages\": resolved,\n    \"limitations\": [\n        \"This is an actual fresh-cache causal reproduction on local native musl with the same four target filters.\",\n        \"The original CI wrapper discarded Cargo's detailed metadata stderr; its exact missing package remains unobserved.\",\n        \"No default toolchain, global Cargo cache, caller wrapper configuration or service registration was changed.\",\n    ],\n}\noutput = ROOT / \".local/checks/run11-cold-cargo-diagnosis.json\"\noutput.write_text(json.dumps(report, indent=2) + \"\\n\")\noutput.chmod(0o600)\nsys.exit(0 if reproduced and report[\"sourceUnchanged\"] and report[\"lockUnchanged\"] else 1)\n",
