            "description": "Workspace ID or slug (when workspace-scoped)"
          },
          "slug": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "auth_type": {
            "type": "string",
            "enum": [
              "oauth_auto",
              "oauth_client_credentials",
              "headers",
              "none"
            ]
          },
          "transport": {
            "type": "string",
